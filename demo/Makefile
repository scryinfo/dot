
ifeq ($(OS),Windows_NT)
	EXE := .exe
else
	EXE :=
endif

.PHONY: clean upgrade format build rebuild

clean:
	command go clean
	cd bench_http && command go clean
	cd redis && command go clean
	cd redis/orm && command go clean
	find . -type f \( -executable -o -name "*.log" -o -name "go.sum" \) -delete
tidy:
	command go mod tidy
	cd bench_http && command go mod tidy
	cd redis && command go mod tidy
	cd redis/orm && command go mod tidy

upgrade:
	command go get -t -u ./... && command go mod tidy
	cd bench_http && command go get -t -u ./... && command go mod tidy
	cd redis && command go get -t -u ./... && command go mod tidy
	cd redis/orm && command go get -t -u ./... && command go mod tidy
format:
	command go fmt ./...
	cd bench_http && command go fmt ./...
	cd redis && command go fmt ./...
	cd redis/orm && command go fmt ./...
build: redis/go_redis${EXE} redis/orm/orm${EXE}
	command go build ./...
	# cd bench_http && command go build ./...

rebuild: clean build
test:
	command go test -tags="release" ./...
	cd bench_http && command go test -tags="release" ./...
	cd redis && command go test -tags="release" ./...
	cd redis/orm && command go test -tags="release" ./...

go_fix:
	command go fix ./...
	cd bench_http && command go fix ./...
	cd redis && command go fix ./...
	cd redis/orm && command go fix ./...

lint:
	command go vet ./...
	govulncheck ./...
	staticcheck ./...
	nilaway ./...
	golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd bench_http && command go vet ./...
	cd bench_http && govulncheck ./...
	cd bench_http && staticcheck ./...
	cd bench_http && nilaway ./...
	cd bench_http && golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd redis && command go vet ./...
	cd redis && govulncheck ./...
	cd redis && staticcheck ./...
	cd redis && nilaway ./...
	cd redis && golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd redis/orm && command go vet ./...
	cd redis/orm && govulncheck ./...
	cd redis/orm && staticcheck ./...
	cd redis/orm && nilaway ./...
	cd redis/orm && golangci-lint run --no-config --disable-all -E zerologlint ./...
lint_more:
	gosec -tags "Release" -quiet ./...
	revive ./...
	gocyclo ./...
	cd bench_http && gosec -tags "Release" -quiet ./...
	cd bench_http && revive ./...
	cd bench_http && gocyclo ./...
	cd redis && gosec -tags "Release" -quiet ./...
	cd redis && revive ./...
	cd redis && gocyclo ./...
	cd redis/orm && gosec -tags "Release" -quiet ./...
	cd redis/orm && revive ./...
	cd redis/orm && gocyclo ./...

redis/go_redis${EXE}:
	cd redis && command go build -o go_redis${EXE} ./...
redis/orm/orm${EXE}:
	cd redis/orm && command go build -o orm${EXE} ./...
