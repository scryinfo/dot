
ifeq ($(OS),Windows_NT)
	EXE := .exe
	go := go
else
	go := ${shell which go}
	EXE :=
endif
$(info "go: ${go}")

.PHONY: clean upgrade format build rebuild

clean:
	${go} clean
	cd bench_http && ${go} clean
	cd redis && ${go} clean
	cd redis/orm && ${go} clean
	find . -type f \( -executable -o -name "*.log" -o -name "go.sum" \) -delete
tidy:
	${go} mod tidy
	cd bench_http && ${go} mod tidy
	cd redis && ${go} mod tidy
	cd redis/orm && ${go} mod tidy

upgrade:
	${go} get -t -u ./... && ${go} mod tidy
	cd bench_http && ${go} get -t -u ./... && ${go} mod tidy
	cd redis && ${go} get -t -u ./... && ${go} mod tidy
	cd redis/orm && ${go} get -t -u ./... && ${go} mod tidy
format:
	${go} fmt ./...
	cd bench_http && ${go} fmt ./...
	cd redis && ${go} fmt ./...
	cd redis/orm && ${go} fmt ./...
build: redis/go_redis${EXE} redis/orm/orm${EXE}
	${go} build ./...
	# cd bench_http && ${go} build ./...

rebuild: clean build
test:
	${go} test -tags="release" ./...
	cd bench_http && ${go} test -tags="release" ./...
	cd redis && ${go} test -tags="release" ./...
	cd redis/orm && ${go} test -tags="release" ./...

go_fix:
	${go} fix ./...
	cd bench_http && ${go} fix ./...
	cd redis && ${go} fix ./...
	cd redis/orm && ${go} fix ./...

lint:
	${go} vet ./...
	govulncheck ./...
	staticcheck ./...
	nilaway ./...
	golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd bench_http && ${go} vet ./...
	cd bench_http && govulncheck ./...
	cd bench_http && staticcheck ./...
	cd bench_http && nilaway ./...
	cd bench_http && golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd redis && ${go} vet ./...
	cd redis && govulncheck ./...
	cd redis && staticcheck ./...
	cd redis && nilaway ./...
	cd redis && golangci-lint run --no-config --disable-all -E zerologlint ./...
	cd redis/orm && ${go} vet ./...
	cd redis/orm && govulncheck ./...
	cd redis/orm && staticcheck ./...
	cd redis/orm && nilaway ./...
	cd redis/orm && golangci-lint run --no-config --disable-all -E zerologlint ./...
lint_more:
	gosec -tags "Release" -quiet ./...
	revive ./...
	gocyclo ./...
	cd bench_http && gosec -tags "Release" -quiet ./...
	cd bench_http && revive ./...
	cd bench_http && gocyclo ./...
	cd redis && gosec -tags "Release" -quiet ./...
	cd redis && revive ./...
	cd redis && gocyclo ./...
	cd redis/orm && gosec -tags "Release" -quiet ./...
	cd redis/orm && revive ./...
	cd redis/orm && gocyclo ./...

redis/go_redis${EXE}:
	cd redis && ${go} build -o go_redis${EXE} ./...
redis/orm/orm${EXE}:
	cd redis/orm && ${go} build -o orm${EXE} ./...
