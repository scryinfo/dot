{
  "name": "go-rocksdb-project",
  "version": "11.1.2",
  "description": "A library that provides an embeddable, persistent key-value store for fast storage",
  "homepage": "https://github.com/facebook/rocksdb",
  "license": "GPL-2.0-only OR Apache-2.0",
  "supports": "!uwp & !(arm & !arm64 & android)",
  "builtin-baseline": "86f61acf5a72d90847b8137f5a03cffa513f7c75",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "rocksdb",
      "features": ["lz4", "snappy", "zstd", "zlib", "bzip2"]
    },
    {
      "name": "dlfcn-win32"
    }
  ],
  "overrides": [
    {
      "name": "rocksdb",
      "version-string": "11.1.2"
    }
  ]
}
